# 必填。请填写独立的强随机值；留空时 Compose 会拒绝启动。
MAKERHUB_POSTGRES_PASSWORD=
MAKERHUB_CLOAKBROWSER_AUTH_TOKEN=

# 可选自动验证：默认关闭；开启后仅对 3MF 授权页尝试本地视觉验证，失败仍需人工完成。
MAKERHUB_AUTO_VERIFY_3MF=false

# 其余默认配置已直接写入 compose.yaml，无需复制到这里。
# 仅在远程访问 CloakBrowser Manager 时取消注释并修改下面两项。
# MAKERHUB_CLOAKBROWSER_BIND_ADDRESS=192.168.1.20
# MAKERHUB_CLOAKBROWSER_PUBLIC_URL=http://192.168.1.20:9050

# 可选资源回收策略：CB 人工操作/后台抓取空闲秒数、Worker 安全间隙/硬上限、整理器 RSS 阈值（MiB）；各项设为 0 可禁用。
# MAKERHUB_CLOAKBROWSER_IDLE_SECONDS=1800
# MAKERHUB_CLOAKBROWSER_AUTOMATION_IDLE_SECONDS=120
# MAKERHUB_WORKER_RECYCLE_RSS_MIB=2048
# MAKERHUB_WORKER_HARD_RECYCLE_RSS_MIB=4096
# MAKERHUB_ORGANIZER_RECYCLE_RSS_MIB=768

# 仅在反向代理地址明确可控时填写，多个地址用逗号分隔。
# MAKERHUB_TRUSTED_PROXIES=127.0.0.1
